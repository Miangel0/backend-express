generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  translations Translation[]
}

model Translation {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoPath String // Path to stored video file
  result    Json // JSON result from AI service
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gif {
  id     Int    @id @default(autoincrement())
  word   String @unique
  gifUrl String
}

enum Role {
  USER
  ADMIN
}
