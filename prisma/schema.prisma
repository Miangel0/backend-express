generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
  role     Role   @default(USER)

  // Relations
  translations Translation[]
}

model Translation {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoPath String // Path to stored video file
  result    Json // JSON result from AI service
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}
